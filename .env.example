# Copy to .env and fill in. .env is gitignored — never commit real keys.
#   cp .env.example .env

# ---- Match search (the "Fetch latest match between A and B" box) -------------
# CricAPI (https://cricapi.com) — the AUTHORITATIVE match resolver. Without it
# the search falls back to grounded AI search, which is prone to answering
# "latest India v Pakistan" with a famous OLD match instead of the recent one.
# The free plan is 100 calls/day; responses are cached on disk under .cache/ so
# repeat searches are free.
CRICAPI_KEY=

# Call-budget knobs for one lookup. Raise for better coverage, lower to stretch
# a free plan further. Worst case per NEW team pair ≈ 1 + TERMS + PROBE + 1.
CRICAPI_MAX_SERIES_TERMS=4
CRICAPI_MAX_SERIES_PROBE=4

# Multi-team tournaments are named after the event, not the teams, so a
# "India"/"Pakistan" series search cannot see a World Cup fixture. These terms
# are searched too when no match link is pasted. Comma-separated.
MATCH_TOURNAMENTS=t20 world cup,cricket world cup,asia cup,champions trophy,premier league,tri-series,tri nation

# Freshness gate. A resolved match older than MAX_AGE_DAYS is REJECTED (it is
# not "the latest"); older than STALE_DAYS it is shown with a warning.
MATCH_STALE_DAYS=90
MATCH_MAX_AGE_DAYS=365

# ---- AI blurbs ---------------------------------------------------------------
# Google Gemini (https://aistudio.google.com/app/apikey). Optional: without it
# rankings still compute and blurbs fall back to deterministic templates.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_INGEST_MODEL=gemini-2.5-flash-lite

# Minimum critic score (0-10) a generated blurb must clear before publishing.
BLURB_MIN_SCORE=8
# stats = ground blurbs against the local dataset; web = live Google Search.
BLURB_GROUNDING=stats
